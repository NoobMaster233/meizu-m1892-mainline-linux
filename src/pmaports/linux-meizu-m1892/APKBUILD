builddir="$srcdir/linux-$_tag"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$CARCH" .config
	install -Dm644 "$srcdir/panel-samsung-sofef00m.c" \
		drivers/gpu/drm/panel/panel-samsung-sofef00m.c
	for dts in "$srcdir"/sdm845-meizu-m1892*.dts; do
		install -Dm644 "$dts" "arch/arm64/boot/dts/qcom/${dts##*/}"
	done
}

build() {
	unset LDFLAGS
	export KBUILD_BUILD_USER="m1892"
	export KBUILD_BUILD_HOST="k1-clean"
	export KBUILD_BUILD_VERSION=1
	# ISO form is accepted by Alpine BusyBox and remains human-readable in
	# uname while representing the same frozen UTC build instant as K1.
	export KBUILD_BUILD_TIMESTAMP="2026-05-09 04:21:17 UTC"

	make ARCH="$_carch" LLVM=1 LOCALVERSION= olddefconfig
	test "$(make -s ARCH="$_carch" LLVM=1 LOCALVERSION= kernelrelease)" \
		= "7.1.0-rc1-sdm845"
	make ARCH="$_carch" LLVM=1 LOCALVERSION= \
		Image.gz modules "qcom/$_dtb.dtb"
}

package() {
	install -Dm644 "arch/$_carch/boot/Image.gz" "$pkgdir/boot/vmlinuz"
	install -Dm644 .config "$pkgdir/boot/config-7.1.0-rc1-sdm845"
	install -Dm644 "arch/$_carch/boot/dts/qcom/$_dtb.dtb" \
		"$pkgdir/boot/dtbs/qcom/$_dtb.dtb"

	make modules_install ARCH="$_carch" LLVM=1 LOCALVERSION= \
		INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1
	rm -f "$pkgdir"/usr/lib/modules/*/build \
		"$pkgdir"/usr/lib/modules/*/source

	install -Dm644 include/config/kernel.release \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"
}

