#!/bin/sh
# SPDX-License-Identifier: MIT
set -u

# This helper is deliberately explicit: no systemd unit starts it.  Its normal
# mode is read-only.  --mobile-only temporarily deactivates only Wi-Fi
# connections that were active at entry and restores those exact UUIDs on all
# handled normal, failure, and signal paths.  Fixed JSONL records are used so no
# IMSI, telephone number, address, DNS server, connection UUID, or Wi-Fi name is
# copied into acceptance output.

PATH=/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
export PATH LC_ALL
umask 077

schema=m1892-cellular-acceptance/v1
mode=default
timeout_seconds=45
profile=/etc/NetworkManager/system-connections/m1892-cellular.nmconnection
provider_db=/usr/share/mobile-broadband-provider-info/serviceproviders.xml
ordinary_if=
ims_if=
mm_service=org.freedesktop.ModemManager1
mm_modem_iface=org.freedesktop.ModemManager1.Modem
mm_3gpp_iface=org.freedesktop.ModemManager1.Modem.Modem3gpp
mm_bearer_iface=org.freedesktop.ModemManager1.Bearer
failures=0
final_emitted=no
wifi_restore_required=no
wifi_uuids=
wifi_restore_deadline=0
signal_received=no
configuration_ok=no
data_readiness_ok=no
ims_readiness_ok=no
e2e_attempted=no
e2e_passed=no

usage()
{
	cat >&2 <<'EOF'
usage: cellular-acceptance [--mobile-only] [--timeout SECONDS]
       cellular-acceptance --self-test

Default mode performs no network state changes.  --mobile-only temporarily
disconnects active Wi-Fi, refuses to run while any remote SSH session is active,
performs interface-bound mobile-data probes, and restores the prior Wi-Fi
connections before returning.
EOF
}

emit_check()
{
	# Check names and results are internal constants, never runtime data.
	printf '{"schema":"%s","check":"%s","result":"%s"}\n' \
		"$schema" "$1" "$2"
}

pass_check()
{
	emit_check "$1" PASS
}

fail_check()
{
	failures=$((failures + 1))
	emit_check "$1" FAIL
}

report_flag()
{
	if [ "$2" = yes ]; then
		pass_check "$1"
	else
		fail_check "$1"
	fi
}

report_diagnostic()
{
	if [ "$2" = yes ]; then
		diagnostic_result=PASS
	else
		diagnostic_result=FAIL
	fi
	printf '{"schema":"%s","check":"%s","result":"%s","role":"diagnostic"}\n' \
		"$schema" "$1" "$diagnostic_result"
}

contains_exact_line()
{
	printf '%s\n' "$1" | grep -Fxq -- "$2"
}

dbus_uint()
{
	value=$(busctl --system --auto-start=no get-property "$mm_service" "$1" "$2" "$3" \
		2>/dev/null) || return 1
	set -- $value
	[ "$#" -eq 2 ] && [ "$1" = u ] || return 1
	case $2 in
		''|*[!0-9]*) return 1 ;;
	esac
	printf '%s\n' "$2"
}

dbus_string()
{
	value=$(busctl --system --auto-start=no get-property "$mm_service" "$1" "$2" "$3" \
		2>/dev/null) || return 1
	case $value in
		's "'*'"')
			value=${value#s \"}
			value=${value%\"}
			printf '%s\n' "$value"
			;;
		*) return 1 ;;
	esac
}

dbus_true()
{
	[ "$(busctl --system --auto-start=no get-property "$mm_service" "$1" "$2" "$3" \
		2>/dev/null || true)" = 'b true' ]
}

modem_paths()
{
	busctl --system --auto-start=no --list tree "$mm_service" 2>/dev/null |
		sed -n '\#^/org/freedesktop/ModemManager1/Modem/[0-9][0-9]*$#p'
}

bearer_paths()
{
	value=$(busctl --system --auto-start=no get-property "$mm_service" "$1" \
		"$mm_modem_iface" Bearers 2>/dev/null) || return 1
	printf '%s\n' "$value" | tr '"' '\n' |
		sed -n '\#^/org/freedesktop/ModemManager1/Bearer/[0-9][0-9]*$#p'
}

connected_bearer_for_interface()
{
	target=$1
	paths=$(bearer_paths "$modem_path" 2>/dev/null || true)
	for bearer_path in $paths; do
		dbus_true "$bearer_path" "$mm_bearer_iface" Connected || continue
		bearer_if=$(dbus_string "$bearer_path" "$mm_bearer_iface" Interface \
			2>/dev/null || true)
		[ "$bearer_if" = "$target" ] && return 0
	done
	return 1
}

valid_qmap_interface()
{
	printf '%s\n' "$1" | grep -Eq '^qmapmux[0-9]+\.[0-9]+$'
}

connected_interface_for_apn()
{
	target_apn=$1
	paths=$(bearer_paths "$modem_path" 2>/dev/null || true)
	for bearer_path in $paths; do
		dbus_true "$bearer_path" "$mm_bearer_iface" Connected || continue
		bearer_info=$(mmcli -b "$bearer_path" --output-keyvalue 2>/dev/null || true)
		bearer_apn=$(printf '%s\n' "$bearer_info" |
			sed -n 's/^bearer\.properties\.apn[[:space:]]*: //p' |
			tr '[:upper:]' '[:lower:]')
		[ "$bearer_apn" = "$target_apn" ] || continue
		bearer_if=$(dbus_string "$bearer_path" "$mm_bearer_iface" Interface \
			2>/dev/null || true)
		valid_qmap_interface "$bearer_if" || continue
		printf '%s\n' "$bearer_if"
		return 0
	done
	return 1
}

has_ipv4()
{
	ip -4 -o address show dev "$1" scope global 2>/dev/null |
		awk '$0 !~ / tentative([[:space:]]|$)| dadfailed([[:space:]]|$)/ { found=1 }
			END { exit found ? 0 : 1 }'
}

has_global_ipv6()
{
	ip -6 -o address show dev "$1" scope global 2>/dev/null |
		awk '$0 !~ / tentative([[:space:]]|$)| dadfailed([[:space:]]|$)/ { found=1 }
			END { exit found ? 0 : 1 }'
}

route_uses_interface()
{
	route=$1
	target_if=$2
	previous=
	for field in $route; do
		if [ "$previous" = dev ]; then
			[ "$field" = "$target_if" ]
			return
		fi
		previous=$field
	done
	return 1
}

main_default_absent_for_interface()
{
	target_if=$1
	defaults=$(ip -6 route show table main default dev "$target_if" 2>/dev/null) ||
		return 1
	[ -z "$defaults" ]
}

value_is_zero()
{
	[ "$1" = 0 ]
}

sysctl_is_zero()
{
	path=$1
	[ -r "$path" ] || return 1
	value=
	if ! IFS= read -r value <"$path"; then
		# procfs/sysctl pseudo-files may expose a value without a trailing
		# newline, which makes POSIX read return non-zero after setting it.
		[ -n "$value" ] || return 1
	fi
	value_is_zero "$value"
}

monotonic_now()
{
	value=$(awk 'NR == 1 { print int($1); found=1; exit }
		END { if (!found) exit 1 }' /proc/uptime 2>/dev/null) || return 1
	case $value in
		''|*[!0-9]*) return 1 ;;
	esac
	printf '%s\n' "$value"
}

registration_is_usable()
{
	# HOME, ROAMING, and their CSFB-not-preferred variants are registered.
	case $1 in
		1|5|9|10) return 0 ;;
		*) return 1 ;;
	esac
}

access_has_lte()
{
	case $1 in
		''|*[!0-9]*) return 1 ;;
	esac
	[ $(( $1 & 16384 )) -ne 0 ]
}

active_wifi_uuids()
{
	query_deadline=$1
	raw_connections=$(bounded_nmcli_query "$query_deadline" \
		-t -e no -f UUID,TYPE connection show --active 2>/dev/null) || return 1
	printf '%s\n' "$raw_connections" |
		awk -F: '$2 == "wifi" || $2 == "802-11-wireless" {
			if ($1 ~ /^[0123456789abcdefABCDEF-]+$/ && length($1) == 36)
				print $1
			else
				invalid=1
		}
		END { exit invalid ? 1 : 0 }'
}

connection_uuid_is_active()
{
	query_deadline=$1
	query_uuid=$2
	state=$(bounded_nmcli_query "$query_deadline" \
		-g GENERAL.STATE connection show uuid "$query_uuid" 2>/dev/null) || return 1
	case $state in
		activated*) return 0 ;;
		*) return 1 ;;
	esac
}

remaining_budget_seconds()
{
	budget_deadline=$1
	budget_cap=$2
	case $budget_deadline in ''|*[!0-9]*) return 1 ;; esac
	case $budget_cap in ''|*[!0-9]*) return 1 ;; esac
	budget_now=$(monotonic_now 2>/dev/null) || return 1
	budget_remaining=$((budget_deadline - budget_now))
	# Reserve the two-second SIGKILL grace used by coreutils timeout.  This
	# keeps the command and its kill grace inside the shared hard deadline.
	[ "$budget_remaining" -gt 2 ] || return 1
	budget_seconds=$((budget_remaining - 2))
	[ "$budget_seconds" -le "$budget_cap" ] || budget_seconds=$budget_cap
	[ "$budget_seconds" -gt 0 ] || return 1
	printf '%s\n' "$budget_seconds"
}

bounded_nmcli_query()
{
	query_deadline=$1
	shift
	bounded_command "$query_deadline" 15 nmcli "$@"
}

bounded_command()
{
	command_deadline=$1
	command_cap=$2
	shift 2
	command_budget=$(remaining_budget_seconds "$command_deadline" "$command_cap") ||
		return 1
	timeout -k 2 "$command_budget" "$@"
}

restore_wifi()
{
	[ "$wifi_restore_required" = yes ] || return 0
	restore_ok=yes
	restore_deadline=$wifi_restore_deadline
	case $restore_deadline in
		''|*[!0-9]*|0) return 1 ;;
	esac
	for wifi_uuid in $wifi_uuids; do
		if restore_budget=$(remaining_budget_seconds "$restore_deadline" 30); then
			if ! timeout -k 2 "$restore_budget" nmcli --wait "$restore_budget" \
					connection up uuid "$wifi_uuid" >/dev/null 2>&1; then
				restore_ok=no
			fi
		else
			restore_ok=no
			break
		fi
	done
	if [ "$restore_ok" = yes ]; then
		for wifi_uuid in $wifi_uuids; do
			connection_uuid_is_active "$restore_deadline" "$wifi_uuid" ||
				restore_ok=no
		done
	fi
	if [ "$restore_ok" = yes ]; then
		wifi_restore_required=no
		return 0
	fi
	return 1
}

on_signal()
{
	signal_received=yes
	exit 130
}

on_exit()
{
	status=$?
	trap - EXIT
	# A second ordinary signal must not interrupt rollback.  SIGKILL and power
	# loss cannot be trapped, so callers must retain an independent console.
	trap '' HUP INT QUIT TERM PIPE
	restore_result=not-needed
	if [ "$wifi_restore_required" = yes ]; then
		if restore_wifi; then
			restore_result=PASS
		else
			restore_result=FAIL
		fi
	fi
	if [ "$final_emitted" = no ]; then
		if [ "$restore_result" != not-needed ]; then
			emit_check wifi_restore "$restore_result"
		fi
		if [ "$signal_received" = yes ]; then
			emit_check interrupted FAIL
		else
			emit_check unexpected_exit FAIL
		fi
		if [ "$configuration_ok" = yes ]; then
			exit_configuration_result=PASS
		else
			exit_configuration_result=FAIL
		fi
		set -- $(data_summary "$mode" "$e2e_attempted" "$e2e_passed" \
			"$data_readiness_ok")
		exit_data_scope=$1
		exit_data_result=$2
		if [ "$ims_readiness_ok" = yes ]; then
			exit_ims_result=PASS
		else
			exit_ims_result=FAIL
		fi
		printf '{"schema":"%s","mode":"%s","result":"FAIL","configuration_result":"%s","data_scope":"%s","data_result":"%s","ims_scope":"runtime-readiness-not-telephony-e2e","ims_readiness_result":"%s"}\n' \
			"$schema" "$mode" "$exit_configuration_result" "$exit_data_scope" \
			"$exit_data_result" "$exit_ims_result"
	fi
	exit "$status"
}

data_summary()
{
	summary_mode=$1
	summary_attempted=$2
	summary_passed=$3
	summary_ready=$4
	if [ "$summary_mode" = mobile-only ] && [ "$summary_attempted" = yes ]; then
		if [ "$summary_passed" = yes ]; then
			printf '%s %s\n' mobile-internet-e2e PASS
		else
			printf '%s %s\n' mobile-internet-e2e FAIL
		fi
	elif [ "$summary_mode" = mobile-only ]; then
		printf '%s %s\n' mobile-internet-e2e-not-run FAIL
	elif [ "$summary_ready" = yes ]; then
		printf '%s %s\n' runtime-readiness PASS
	else
		printf '%s %s\n' runtime-readiness FAIL
	fi
}

finish()
{
	final_emitted=yes
	if [ "$failures" -eq 0 ]; then
		result=PASS
		status=0
	else
		result=FAIL
		status=1
	fi
	if [ "$configuration_ok" = yes ]; then
		configuration_result=PASS
	else
		configuration_result=FAIL
	fi
	set -- $(data_summary "$mode" "$e2e_attempted" "$e2e_passed" \
		"$data_readiness_ok")
	data_scope=$1
	data_result=$2
	if [ "$ims_readiness_ok" = yes ]; then
		ims_result=PASS
	else
		ims_result=FAIL
	fi
	printf '{"schema":"%s","mode":"%s","result":"%s","configuration_result":"%s","data_scope":"%s","data_result":"%s","ims_scope":"runtime-readiness-not-telephony-e2e","ims_readiness_result":"%s"}\n' \
		"$schema" "$mode" "$result" "$configuration_result" "$data_scope" \
		"$data_result" "$ims_result"
	if [ "$wifi_restore_required" = no ]; then
		trap - HUP INT QUIT TERM PIPE EXIT
	fi
	exit "$status"
}

self_test()
{
	self_failures=0
	if contains_exact_line 'qmapmux0.0
qmapmux0.1' qmapmux0.1; then
		emit_check selftest_exact_line PASS
	else
		emit_check selftest_exact_line FAIL
		self_failures=$((self_failures + 1))
	fi
	if valid_qmap_interface qmapmux0.0 && valid_qmap_interface qmapmux27.1 &&
		! valid_qmap_interface qmapmux.1 && ! valid_qmap_interface wlan0; then
		emit_check selftest_qmap_interface PASS
	else
		emit_check selftest_qmap_interface FAIL
		self_failures=$((self_failures + 1))
	fi
	if route_uses_interface \
		'1.1.1.1 via 192.0.2.1 dev qmapmux0.0 src 192.0.2.2 uid 0' \
		qmapmux0.0 &&
		! route_uses_interface \
			'1.1.1.1 via 192.0.2.1 dev wlan0 src 192.0.2.2 uid 0' \
			qmapmux0.0; then
		emit_check selftest_route_parser PASS
	else
		emit_check selftest_route_parser FAIL
		self_failures=$((self_failures + 1))
	fi
	if registration_is_usable 1 && registration_is_usable 5 &&
		! registration_is_usable 2; then
		emit_check selftest_registration_enum PASS
	else
		emit_check selftest_registration_enum FAIL
		self_failures=$((self_failures + 1))
	fi
	mock_ip_fixture=empty
	ip()
	{
		case $mock_ip_fixture in
			empty) return 0 ;;
			present) printf '%s\n' 'default via 2001:db8::1 dev qmapmux0.1'; return 0 ;;
			error) return 1 ;;
		esac
		return 1
	}
	if main_default_absent_for_interface qmapmux0.1 &&
		mock_ip_fixture=present &&
		! main_default_absent_for_interface qmapmux0.1 &&
		mock_ip_fixture=error &&
		! main_default_absent_for_interface qmapmux0.1; then
		emit_check selftest_main_default_absence_fail_closed PASS
	else
		emit_check selftest_main_default_absence_fail_closed FAIL
		self_failures=$((self_failures + 1))
	fi
	if value_is_zero 0 && ! value_is_zero 1 && ! value_is_zero ''; then
		emit_check selftest_exact_zero_parser PASS
	else
		emit_check selftest_exact_zero_parser FAIL
		self_failures=$((self_failures + 1))
	fi
	if access_has_lte 16384 && access_has_lte 16386 &&
		! access_has_lte 512; then
		emit_check selftest_lte_mask PASS
	else
		emit_check selftest_lte_mask FAIL
		self_failures=$((self_failures + 1))
	fi
	if [ "$(data_summary mobile-only no no yes)" = \
		'mobile-internet-e2e-not-run FAIL' ] &&
		[ "$(data_summary mobile-only yes yes yes)" = \
		'mobile-internet-e2e PASS' ] &&
		[ "$(data_summary mobile-only yes no yes)" = \
		'mobile-internet-e2e FAIL' ] &&
		[ "$(data_summary default no no yes)" = 'runtime-readiness PASS' ]; then
		emit_check selftest_data_scope PASS
	else
		emit_check selftest_data_scope FAIL
		self_failures=$((self_failures + 1))
	fi
	# Static command fixtures prove that every NetworkManager query is bounded,
	# timeout is fail-closed, and rollback clears its flag only after an
	# independently bounded activation-state query succeeds.
	mock_nmcli_up_calls=0
	mock_timeout_fixture=pass
	mock_wifi_fixture=valid
	monotonic_now() { printf '%s\n' 1000; }
	timeout()
	{
		[ "$1" = -k ] && [ "$2" = 2 ] || return 1
		shift 2
		case $1 in ''|*[!0-9]*) return 1 ;; esac
		shift
		case $mock_timeout_fixture:$* in
			snapshot-timeout:*'UUID,TYPE connection show --active'*) return 124 ;;
			state-timeout:*'GENERAL.STATE connection show uuid'*) return 124 ;;
			route-timeout:'ip -4 route get '*) return 124 ;;
		esac
		"$@"
	}
	nmcli()
	{
		case $* in
			*'UUID,TYPE connection show --active'*)
				case $mock_wifi_fixture in
					valid)
						printf '%s\n' \
							'00000000-0000-0000-0000-000000000001:wifi' \
							'00000000-0000-0000-0000-000000000002:ethernet'
						return 0
						;;
					invalid)
						printf '%s\n' 'not-a-uuid:wifi'
						return 0
						;;
					*) return 1 ;;
				esac
				;;
			*'connection up uuid'*)
				mock_nmcli_up_calls=$((mock_nmcli_up_calls + 1))
				return 0
				;;
			*'GENERAL.STATE connection show uuid'*)
				printf '%s\n' activated
				return 0
				;;
		esac
		return 1
	}
	valid_wifi=$(active_wifi_uuids 1010 2>/dev/null || true)
	mock_wifi_fixture=invalid
	if [ "$valid_wifi" = 00000000-0000-0000-0000-000000000001 ] &&
		! active_wifi_uuids 1010 >/dev/null 2>&1; then
		emit_check selftest_wifi_snapshot_fail_closed PASS
	else
		emit_check selftest_wifi_snapshot_fail_closed FAIL
		self_failures=$((self_failures + 1))
	fi
	mock_wifi_fixture=valid
	mock_timeout_fixture=snapshot-timeout
	if ! active_wifi_uuids 1010 >/dev/null 2>&1; then
		emit_check selftest_wifi_query_timeout_fail_closed PASS
	else
		emit_check selftest_wifi_query_timeout_fail_closed FAIL
		self_failures=$((self_failures + 1))
	fi
	mock_timeout_fixture=pass
	if ! active_wifi_uuids 1002 >/dev/null 2>&1; then
		emit_check selftest_wifi_query_deadline_fail_closed PASS
	else
		emit_check selftest_wifi_query_deadline_fail_closed FAIL
		self_failures=$((self_failures + 1))
	fi
	mock_ip_fixture=present
	mock_timeout_fixture=route-timeout
	if ! bounded_command 1010 5 ip -4 route get 1.1.1.1 >/dev/null 2>&1; then
		emit_check selftest_route_query_timeout_fail_closed PASS
	else
		emit_check selftest_route_query_timeout_fail_closed FAIL
		self_failures=$((self_failures + 1))
	fi
	mock_timeout_fixture=pass
	wifi_uuids=00000000-0000-0000-0000-000000000001
	wifi_restore_required=yes
	wifi_restore_deadline=1015
	if restore_wifi && [ "$mock_nmcli_up_calls" -eq 1 ] &&
		[ "$wifi_restore_required" = no ]; then
		emit_check selftest_wifi_bounded_restore PASS
	else
		emit_check selftest_wifi_bounded_restore FAIL
		self_failures=$((self_failures + 1))
	fi
	wifi_restore_required=yes
	wifi_restore_deadline=1015
	mock_timeout_fixture=state-timeout
	if ! restore_wifi && [ "$wifi_restore_required" = yes ]; then
		emit_check selftest_wifi_restore_query_timeout_fail_closed PASS
	else
		emit_check selftest_wifi_restore_query_timeout_fail_closed FAIL
		self_failures=$((self_failures + 1))
	fi
	mock_timeout_fixture=pass
	wifi_restore_deadline=1002
	up_calls_before_expired_restore=$mock_nmcli_up_calls
	if ! restore_wifi && [ "$wifi_restore_required" = yes ] &&
		[ "$mock_nmcli_up_calls" -eq "$up_calls_before_expired_restore" ]; then
		emit_check selftest_wifi_restore_deadline_fail_closed PASS
	else
		emit_check selftest_wifi_restore_deadline_fail_closed FAIL
		self_failures=$((self_failures + 1))
	fi
	wifi_restore_required=no
	if [ "$self_failures" -eq 0 ]; then
		printf '{"schema":"%s","mode":"self-test","result":"PASS"}\n' "$schema"
		return 0
	fi
	printf '{"schema":"%s","mode":"self-test","result":"FAIL"}\n' "$schema"
	return 1
}

while [ "$#" -gt 0 ]; do
	case $1 in
		--mobile-only)
			mode=mobile-only
			shift
			;;
		--timeout)
			[ "$#" -ge 2 ] || { usage; exit 2; }
			timeout_seconds=$2
			case $timeout_seconds in
				''|*[!0-9]*) usage; exit 2 ;;
			esac
			[ "$timeout_seconds" -le 300 ] || { usage; exit 2; }
			shift 2
			;;
		--self-test)
			[ "$#" -eq 1 ] || { usage; exit 2; }
			self_test
			exit $?
			;;
		-h|--help)
			usage
			exit 0
			;;
		*)
			usage
			exit 2
			;;
	esac
done

trap on_exit EXIT
trap on_signal HUP INT QUIT TERM PIPE

if [ "$(id -u)" -eq 0 ]; then
	pass_check root_privilege
else
	fail_check root_privilege
	finish
fi

missing_command=no
for command_name in awk busctl busybox dpkg dpkg-query grep id ip loginctl \
	mmcli nmcli python3 sed sleep ss stat systemctl timeout tr; do
	command -v "$command_name" >/dev/null 2>&1 || missing_command=yes
done
report_flag required_commands "$([ "$missing_command" = no ] && printf yes || printf no)"
[ "$missing_command" = no ] || finish

device_identity=no
model=
if [ -r /sys/firmware/devicetree/base/model ]; then
	model=$(tr -d '\000' </sys/firmware/devicetree/base/model 2>/dev/null || true)
fi
[ "$model" = 'Meizu 16th Plus (M1892)' ] && device_identity=yes
report_flag device_identity "$device_identity"

os_identity=no
if grep -Fxq 'ID=debian' /etc/os-release 2>/dev/null &&
	grep -Eq '^VERSION_ID="?13"?$' /etc/os-release 2>/dev/null; then
	os_identity=yes
fi
report_flag debian_13 "$os_identity"

profile_semantics_ok=no
