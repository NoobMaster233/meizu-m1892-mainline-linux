if not addresses:
    raise SystemExit(10)
print("dns=PASS", flush=True)

tls_context = ssl.create_default_context()
for address in addresses:
    raw_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    tls_socket = None
    try:
