import ipaddress
import os
import socket
import ssl
import struct
import sys
import time

interface = sys.argv[1]
server_texts = sys.argv[2:]
hostname = "example.com"
deadline = time.monotonic() + 30


def qname(name):
    return b"".join(bytes((len(label),)) + label.encode("ascii")
                    for label in name.split(".")) + b"\0"


def skip_name(packet, offset):
    while True:
        if offset >= len(packet):
            raise ValueError("truncated name")
        length = packet[offset]
        if length & 0xC0 == 0xC0:
            if offset + 1 >= len(packet):
                raise ValueError("truncated pointer")
            return offset + 2
        offset += 1
        if length == 0:
            return offset
        if length & 0xC0 or offset + length > len(packet):
            raise ValueError("invalid label")
        offset += length


def remaining(limit):
    value = deadline - time.monotonic()
    if value <= 0:
        raise TimeoutError
    return min(limit, value)


def resolve_a(server_text):
    server_text = server_text.split("%", 1)[0]
    server = ipaddress.ip_address(server_text)
    query_id = struct.unpack("!H", os.urandom(2))[0]
    query = struct.pack("!HHHHHH", query_id, 0x0100, 1, 0, 0, 0)
    query += qname(hostname) + struct.pack("!HH", 1, 1)
    family = socket.AF_INET6 if server.version == 6 else socket.AF_INET
    with socket.socket(family, socket.SOCK_DGRAM) as dns_socket:
        dns_socket.setsockopt(socket.SOL_SOCKET, socket.SO_BINDTODEVICE,
                              interface.encode("ascii") + b"\0")
        dns_socket.settimeout(remaining(5))
        if family == socket.AF_INET6:
            target = (str(server), 53, 0, socket.if_nametoindex(interface))
        else:
            target = (str(server), 53)
        dns_socket.sendto(query, target)
        packet = dns_socket.recv(4096)
    if len(packet) < 12:
        raise ValueError("short DNS reply")
    reply = struct.unpack("!HHHHHH", packet[:12])
    reply_id, flags, questions, answers = reply[:4]
    if (reply_id != query_id or not flags & 0x8000 or flags & 0x000F or
            questions != 1):
        raise ValueError("invalid DNS reply")
    offset = 12
    for _ in range(questions):
        offset = skip_name(packet, offset)
        if offset + 4 > len(packet):
            raise ValueError("short DNS question")
        offset += 4
    addresses = []
    for _ in range(answers):
        offset = skip_name(packet, offset)
        if offset + 10 > len(packet):
            raise ValueError("short DNS answer")
        answer = struct.unpack("!HHIH", packet[offset:offset + 10])
        answer_type, answer_class, _, length = answer
        offset += 10
        if offset + length > len(packet):
            raise ValueError("short DNS record")
        if answer_type == 1 and answer_class == 1 and length == 4:
            addresses.append(socket.inet_ntop(socket.AF_INET,
                                              packet[offset:offset + 4]))
        offset += length
    return addresses


addresses = []
for server_text in server_texts:
    try:
        addresses = resolve_a(server_text)
    except (OSError, ValueError, TimeoutError, struct.error):
        continue
    if addresses:
