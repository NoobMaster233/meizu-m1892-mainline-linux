#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu

fail() { echo "M1892_OEM_OWNER_PREPARE_FAIL: $*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || fail not-root
owner=${1:-}
case "$owner" in ''|root|m1892-live|m1892-setup) fail invalid-owner ;; esac
[ "${#owner}" -le 31 ] || fail invalid-owner-length
printf '%s\n' "$owner" | grep -Eq '^[a-z_][a-z0-9_-]*[$]?$' || fail invalid-owner
grep -Fxq 'account_mode=oem-owner' /etc/m1892-rootfs-identity || fail account-mode

state_dir=/var/lib/m1892
marker=$state_dir/oem-owner-created
done_marker=$state_dir/oem-setup-cleanup.pass
pending=$state_dir/oem-owner-pending
[ ! -e "$marker" ] && [ ! -e "$done_marker" ] || fail already-finalized
getent passwd | awk -F: '$3 >= 1000 && $3 < 65534 { found=1 } END { exit found ? 0 : 1 }' &&
	fail regular-owner-present
getent passwd "$owner" >/dev/null 2>&1 && fail owner-preexisting
getent group "$owner" >/dev/null 2>&1 && fail owner-group-preexisting

install -d -m 0755 -o 0 -g 0 "$state_dir"
tmp=$state_dir/.oem-owner-pending.$$
trap 'rm -f "$tmp"' EXIT HUP INT TERM
{
	printf 'result=pending\n'
	printf 'account_mode=oem-owner\n'
	printf 'owner=%s\n' "$owner"
	printf 'owner_preexisting=no\n'
	printf 'state=before-user-create\n'
} >"$tmp"
chmod 0600 "$tmp"
if [ -e "$pending" ]; then
	cmp -s "$tmp" "$pending" || fail pending-conflict
	rm -f "$tmp"
else
	sync -f "$tmp"
	mv "$tmp" "$pending"
	sync -f "$state_dir"
fi
trap - EXIT HUP INT TERM
echo M1892_OEM_OWNER_PREPARE_PASS
