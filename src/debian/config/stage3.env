# Reproducible Stage 3 package contract.  Owner credentials and local network
# profiles are deliberately outside this tracked file.
M1892_DEBIAN_SUITE=trixie
M1892_DEBIAN_ARCH=arm64
M1892_DEBIAN_SNAPSHOT=20260907T000000Z
M1892_DEBIAN_MIRROR=https://snapshot.debian.org/archive/debian
M1892_DEBIAN_SECURITY_MIRROR=https://snapshot.debian.org/archive/debian-security
M1892_DEBIAN_COMPONENTS=main,non-free-firmware
M1892_SENSOR_BACKPORT_PACKAGES=iio-sensor-proxy,libssc2,libssc-bin
M1892_MEDIA_TOOL_PACKAGES=gstreamer1.0-tools,v4l-utils
M1892_MMDEBSTRAP_VERSION=1.5.7
M1892_SOURCE_DATE_EPOCH=1788739200
M1892_KERNEL_RELEASE=7.1.0-rc1-sdm845
M1892_STAGE3_SOURCE_RECOVERY_SHA256=e7db2b91ffe1c82f4ac4b61ed56a2271f050e3461c235d17de3831f96f855b9d
M1892_ACCOUNT_MODE=recovery-live

M1892_DEBIAN_BASE_PACKAGES=systemd-sysv,dbus,dbus-user-session,udev,kmod,initramfs-tools,network-manager,openssh-server,ca-certificates,locales
# Maliit remains Qt5 in Debian 13. Qt6 SVG support does not provide its image
# plugin, so both ABI generations are explicit runtime dependencies.
M1892_PLASMA_PACKAGES=plasma-mobile-core,plasma-mobile-phone,sddm,qtwayland5,libqt5svg5,qt6-svg-plugins,libcanberra-pulse,libgl1-mesa-dri,mesa-vulkan-drivers,mesa-utils,fonts-noto-core,fonts-noto-cjk,fonts-noto-color-emoji,qml6-module-org-kde-kirigamiaddons-formcard
M1892_PHONE_PACKAGES=iproute2,iw,rfkill,wpasupplicant,qrtr-tools,rmtfs,tqftpserv
M1892_PHONE_PACKAGES=$M1892_PHONE_PACKAGES,bluez,wireplumber,rtkit,modemmanager,mobile-broadband-provider-info
M1892_PHONE_PACKAGES=$M1892_PHONE_PACKAGES,libqmi-utils,hexagonrpcd
M1892_PHONE_PACKAGES=$M1892_PHONE_PACKAGES,python3-gi,gir1.2-qrtr-1.0
M1892_PHONE_PACKAGES=$M1892_PHONE_PACKAGES,alsa-utils,alsa-ucm-conf,busybox-static,bsdutils,e2fsprogs
M1892_PHONE_PACKAGES=$M1892_PHONE_PACKAGES,libglib2.0-bin,libprotobuf-c1,upower
M1892_STAGE3_REQUIRED_PACKAGES=systemd-sysv,dbus-user-session,network-manager,plasma-mobile-core,plasma-mobile-phone,plasma-mobile,plasma-mobile-tweaks,plasma-dialer,spacebar,callaudiod,mmsd-tng,sddm,maliit-keyboard,qtwayland5,qt6-svg-plugins,libcanberra-pulse,iio-sensor-proxy,pipewire-pulse,wireplumber,rtkit,libgl1-mesa-dri,mesa-vulkan-drivers,fonts-noto-core,fonts-noto-cjk,fonts-noto-color-emoji,qml6-module-org-kde-kirigamiaddons-formcard,iproute2,iw,rfkill,wpasupplicant,qrtr-tools,rmtfs,tqftpserv,bluez,modemmanager,mobile-broadband-provider-info,libqmi-utils,hexagonrpcd,alsa-utils,alsa-ucm-conf,busybox-static,bsdutils,e2fsprogs,libglib2.0-bin,upower
M1892_STAGE3_REQUIRED_PACKAGES=$M1892_STAGE3_REQUIRED_PACKAGES,libprotobuf-c1
M1892_STAGE3_REQUIRED_PACKAGES=$M1892_STAGE3_REQUIRED_PACKAGES,python3-gi,gir1.2-qrtr-1.0
M1892_STAGE3_REQUIRED_PACKAGES=$M1892_STAGE3_REQUIRED_PACKAGES,libssc2,libssc-bin
