# Stage 6 persistent-image contract.  The generic package tar remains governed
# by stage6.env; this file adds only the ext4 capacity needed by daily apps.
[ -n "${M1892_DEBIAN_CONFIG_DIR:-}" ] || {
	echo 'M1892_DEBIAN_STAGE6_IMAGE_CONFIG_FAIL: config-directory-unset' >&2
	return 1
}
# shellcheck disable=SC1091
. "$M1892_DEBIAN_CONFIG_DIR/stage6.env"

M1892_STAGE3_ROOT_MODE=persistent-userdata-image
M1892_ACCOUNT_MODE=development-persistent

# Five GiB leaves bounded update/cache headroom before first boot expands the
# filesystem to the physical userdata partition.  The commissioner accepts
# aligned images from three through eight GiB and still verifies full readback.
M1892_STAGE3_IMAGE_BYTES=5368709120
