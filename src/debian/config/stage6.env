# Reproducible Stage 6 daily-application contract.  Keep owner credentials,
# network profiles, ROMs and third-party Flatpak remotes outside this file.
[ -n "${M1892_DEBIAN_CONFIG_DIR:-}" ] || {
	echo 'M1892_DEBIAN_STAGE6_CONFIG_FAIL: config-directory-unset' >&2
	return 1
}
# shellcheck disable=SC1091
. "$M1892_DEBIAN_CONFIG_DIR/stage3.env"

# plasma-mobile-core recommends Angelfish and QMLKonsole, but the reproducible
# rootfs deliberately disables APT recommends.  List every daily application
# explicitly so package drift cannot silently change the image.
M1892_DAILY_PACKAGES=angelfish,qmlkonsole,dolphin,plasma-systemmonitor,kdeconnect,flatpak,systemd-timesyncd
M1892_DAILY_PACKAGES=$M1892_DAILY_PACKAGES,fastfetch,kde-spectacle
M1892_DAILY_PACKAGES=$M1892_DAILY_PACKAGES,docker.io,docker-cli,docker-compose,docker-buildx
M1892_DAILY_PACKAGES=$M1892_DAILY_PACKAGES,retroarch,libretro-core-info
M1892_DAILY_PACKAGES=$M1892_DAILY_PACKAGES,libretro-gambatte,libretro-mgba,libretro-nestopia
M1892_STAGE3_REQUIRED_PACKAGES=$M1892_STAGE3_REQUIRED_PACKAGES,$M1892_DAILY_PACKAGES
M1892_STAGE3_REQUIRED_PACKAGES=$M1892_STAGE3_REQUIRED_PACKAGES,plasma-settings
M1892_PLASMA_SETTINGS_VERSION=26.02.0-0m1892.1
M1892_STAGE3_ARTIFACT=m1892-debian13-plasma-mobile-stage6-arm64.tar
M1892_STAGE3_LABEL=stage6-daily-rootfs
