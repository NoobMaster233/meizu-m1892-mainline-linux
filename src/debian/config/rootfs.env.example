# Reproducible public defaults. Keep owner credentials and firmware elsewhere.
M1892_DEBIAN_SUITE=trixie
M1892_DEBIAN_ARCH=arm64
M1892_DEBIAN_SNAPSHOT=20260907T000000Z
M1892_DEBIAN_MIRROR=https://snapshot.debian.org/archive/debian
M1892_DEBIAN_SECURITY_MIRROR=https://snapshot.debian.org/archive/debian-security
M1892_DEBIAN_COMPONENTS=main,non-free-firmware
M1892_MMDEBSTRAP_VERSION=1.5.7
M1892_SOURCE_DATE_EPOCH=1788739200

# Stage 1: minimal userspace used to prove systemd switch_root.
M1892_DEBIAN_BASE_PACKAGES=systemd-sysv,dbus,udev,kmod,initramfs-tools,network-manager,openssh-server,ca-certificates,locales

# Roadmap stage 3: use Debian's mobile-core metapackage after the command-line gate passes.
M1892_PLASMA_PACKAGES=plasma-mobile-core

# Roadmap stage 5: phone components remain a separate regression boundary.
M1892_PHONE_PACKAGES=plasma-mobile-phone,feedbackd
