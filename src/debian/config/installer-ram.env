# Headless installation environment, not the installed phone OS.
[ -n "${M1892_DEBIAN_CONFIG_DIR:-}" ] || return 1
. "$M1892_DEBIAN_CONFIG_DIR/rootfs.env.example"
M1892_DEBIAN_BASE_PACKAGES=systemd-sysv,dbus,udev,kmod,util-linux,e2fsprogs,python3,unzip,curl,busybox-static,ca-certificates,locales
