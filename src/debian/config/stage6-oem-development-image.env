# Local development variant of the formal OEM image. It keeps the authenticated
# USB ACM recovery console available while the candidate is under test. The
# public/final OEM configuration remains stage6-oem-image.env and defaults to a
# disabled development console.
[ -n "${M1892_DEBIAN_CONFIG_DIR:-}" ] || {
	echo 'M1892_DEBIAN_STAGE6_OEM_DEVELOPMENT_IMAGE_CONFIG_FAIL: config-directory-unset' >&2
	return 1
}
# shellcheck disable=SC1091
. "$M1892_DEBIAN_CONFIG_DIR/stage6-oem-image.env"

M1892_STAGE3_DEVELOPMENT_USB=yes
# Long suspend failed the storage/recovery gates. Development and public
# images must both retain the accepted masked policy; experiments are opt-in.
M1892_STAGE3_SUSPEND_POLICY=masked
