# Formal owner-setup package contract.  The preinstalled system creates the
# owner's account on first boot with Debian's Calamares OEM mode.
[ -n "${M1892_DEBIAN_CONFIG_DIR:-}" ] || {
	echo 'M1892_DEBIAN_STAGE6_OEM_CONFIG_FAIL: config-directory-unset' >&2
	return 1
}
# shellcheck disable=SC1091
. "$M1892_DEBIAN_CONFIG_DIR/stage6.env"

M1892_OEM_PACKAGES=calamares,pkexec,sudo
M1892_DAILY_PACKAGES=$M1892_DAILY_PACKAGES,$M1892_OEM_PACKAGES
M1892_STAGE3_REQUIRED_PACKAGES=$M1892_STAGE3_REQUIRED_PACKAGES,$M1892_OEM_PACKAGES
M1892_STAGE3_ARTIFACT=m1892-debian13-plasma-mobile-stage6-oem-arm64.tar
M1892_STAGE3_LABEL=stage6-daily-oem-rootfs
