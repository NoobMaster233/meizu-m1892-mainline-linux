# Formal persistent-image contract.  No owner identity or private credential
# is embedded; Calamares creates the owner on the first graphical boot.
[ -n "${M1892_DEBIAN_CONFIG_DIR:-}" ] || {
	echo 'M1892_DEBIAN_STAGE6_OEM_IMAGE_CONFIG_FAIL: config-directory-unset' >&2
	return 1
}
# shellcheck disable=SC1091
. "$M1892_DEBIAN_CONFIG_DIR/stage6-oem.env"

M1892_STAGE3_ROOT_MODE=persistent-userdata-image
M1892_ACCOUNT_MODE=oem-owner
M1892_STAGE3_IMAGE_BYTES=5368709120
