#!/sbin/openrc-run

description="M1892 IMS Data service with qmapmux IPv6 configuration"
command=/usr/local/sbin/m1892-81voltd
command_background=true
pidfile=/run/81voltd.pid
output_log=/var/log/m1892-81voltd.log
error_log=/var/log/m1892-81voltd.log

export G_MESSAGES_DEBUG=all

depend()
{
	need modemmanager
	after m1892-radio-bootstrap m1892-cellular-prepare
	before m1892-qcom-imsd
}

start_pre()
{
	checkpath -d -m 0755 /var/log

	# Never hold the default runlevel while QRTR firmware and ordinary cellular
	# data are still converging. NetworkManager's dispatcher retries this exact
	# service when the GSM connection really becomes active.
	mmcli -L 2>/dev/null |
		grep -Eq '/org/freedesktop/ModemManager1/Modem/[0-9]+' &&
		nmcli -t -f TYPE,STATE connection show --active 2>/dev/null |
		grep -qx 'gsm:activated' && return 0

	eerror "ordinary cellular data is not active yet; dispatcher will retry IMS"
	return 1
}
