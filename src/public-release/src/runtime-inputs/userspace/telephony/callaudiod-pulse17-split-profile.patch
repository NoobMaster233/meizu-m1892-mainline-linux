+/*
+ * PulseAudio 17 expands one UCM verb into multiple profiles when the output
+ * devices share a PCM (for example "Voice Call (Earpiece, Mic)" and
+ * "Voice Call (Mic, Speaker)").  The historical callaudiod path tries to
+ * change an output port inside the active profile, but the Speaker port is
+ * not part of the Earpiece profile.  Select the matching split voice profile
+ * instead and let PulseAudio run the UCM device transition.
+ */
+static void set_speaker_profile(pa_context *ctx, const pa_card_info *info, int eol, void *data)
+{
+    CadPulseOperation *operation = data;
+    pa_card_profile_info2 *profile;
+    const char *target_profile = NULL;
+    uint32_t target_priority = 0;
+    pa_operation *op = NULL;
+
+    if (eol != 0)
+        return;
+
+    if (!info || info->index != operation->pulse->card_id)
+        goto complete;
+
+    for (int i = 0; i < info->n_profiles; i++) {
+        gboolean has_speaker;
+
+        profile = info->profiles2[i];
+        has_speaker = g_strstr_len(profile->name, -1, "Speaker") != NULL;
+
+        if (!profile->available ||
+            !g_str_has_prefix(profile->name, SND_USE_CASE_VERB_VOICECALL) ||
+            has_speaker != (gboolean)operation->value ||
+            profile->priority <= target_priority)
+            continue;
+
+        target_profile = profile->name;
+        target_priority = profile->priority;
+    }
+
+    if (target_profile &&
+        (!info->active_profile2 ||
+         g_strcmp0(info->active_profile2->name, target_profile) != 0)) {
+        g_debug("switching speaker state through split profile '%s'", target_profile);
+        op = pa_context_set_card_profile_by_index(ctx, operation->pulse->card_id,
+                                                  target_profile,
+                                                  operation_complete_cb, operation);
+    }
+
+    if (op) {
+        pa_operation_unref(op);
+        return;
+    }
+
+complete:
+    operation_complete_cb(ctx, target_profile != NULL, operation);
+}
