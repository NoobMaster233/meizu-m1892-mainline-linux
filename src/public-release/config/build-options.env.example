# M1892 source-build account options.
# Source this file before running the documented pmbootstrap config commands.

# Hardware services discover the active graphical session dynamically.  The
# username is therefore a build input, not a runtime hardware identifier.
M1892_BUILD_USER=m1892
M1892_BUILD_HOSTNAME=m1892-mainline

# Optional fast-path access for the prebuilt, firmware-free base. Point this
# at your existing public-key file before running make-local-firmware-image.sh.
# The key is injected only into your local firmware-complete image; it is never
# copied into the public base or source archive. Leave empty to keep SSH login
# locked until you provision access through a recovery/console path.
M1892_ROOT_AUTHORIZED_KEYS_FILE=

# Keep passwords out of this file. pmbootstrap's --password option handles its
# argument as plaintext and may log it; this release leaves password login
# locked and provisions access after installation.
