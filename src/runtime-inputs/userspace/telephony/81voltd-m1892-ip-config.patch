+/*
+ * ModemManager creates the multiplexed IMS bearer on M1892, but does not
+ * configure the resulting qmapmux netdev because the bearer was requested by
+ * the modem through IMSD rather than by NetworkManager.  The modem cannot
+ * complete IMS registration until this link has its reported IPv6 address and
+ * route.  Keep this beside bearer ownership in 81voltd so reconnects follow
+ * the same path and do not depend on a polling helper.
+ */
+static gboolean run_ip(gchar **argv)
+{
+	GError *err = NULL;
+	gchar *stderr_buf = NULL;
+	gint status = 0;
+	gboolean ok;
+
+	ok = g_spawn_sync(NULL, argv, NULL, G_SPAWN_SEARCH_PATH,
+			  NULL, NULL, NULL, &stderr_buf, &status, &err);
+	if (!ok) {
+		g_warning("Failed to execute ip: %s", err->message);
+		g_clear_error(&err);
+		g_free(stderr_buf);
+		return FALSE;
+	}
+
+	if (!g_spawn_check_wait_status(status, &err)) {
+		g_warning("ip command failed: %s%s%s", err->message,
+			  stderr_buf && *stderr_buf ? ": " : "",
+			  stderr_buf && *stderr_buf ? stderr_buf : "");
+		g_clear_error(&err);
+		g_free(stderr_buf);
+		return FALSE;
+	}
+
+	g_free(stderr_buf);
+	return TRUE;
+}
+
+static gboolean write_sysctl_zero(const gchar *path)
+{
+	int fd;
+	ssize_t written;
+
+	fd = open(path, O_WRONLY | O_CLOEXEC);
+	if (fd < 0) {
+		g_warning("Failed to open %s: %s", path, g_strerror(errno));
+		return FALSE;
+	}
+
+	written = write(fd, "0\n", 2);
+	if (close(fd) < 0 || written != 2) {
+		g_warning("Failed to write %s: %s", path, g_strerror(errno));
+		return FALSE;
+	}
+
+	return TRUE;
+}
+
+static void configure_m1892_ims_link(MMBearer *bearer)
+{
+	MMBearerIpConfig *cfg;
+	const gchar *iface, *address, *gateway;
+	g_autofree gchar *cidr = NULL;
+	g_autofree gchar *accept_dad = NULL;
+	g_autofree gchar *dad_transmits = NULL;
+	guint prefix;
+	gchar *link_argv[] = { "ip", "link", "set", "dev", NULL, "up", NULL };
+	gchar *addr_argv[] = { "ip", "-6", "addr", "replace", NULL,
+			       "dev", NULL, NULL };
+	gchar *route_argv[] = { "ip", "-6", "route", "replace", "default",
+				"via", NULL, "dev", NULL, "metric", "1024", NULL };
+
+	if (!mm_bearer_get_connected(bearer))
+		return;
+
+	iface = mm_bearer_get_interface(bearer);
+	if (!iface || !g_str_has_prefix(iface, "qmapmux"))
+		return;
+
+	cfg = mm_bearer_get_ipv6_config(bearer);
+	if (!cfg)
+		return;
+
+	address = mm_bearer_ip_config_get_address(cfg);
+	gateway = mm_bearer_ip_config_get_gateway(cfg);
+	prefix = mm_bearer_ip_config_get_prefix(cfg);
+	if (!address || !*address || prefix == 0 || prefix > 128) {
+		g_warning("IMS bearer %s has no usable IPv6 configuration", iface);
+		g_object_unref(cfg);
+		return;
+	}
+
+	link_argv[4] = (gchar *)iface;
+	if (!run_ip(link_argv)) {
+		g_object_unref(cfg);
+		return;
+	}
+
+	accept_dad = g_strdup_printf("/proc/sys/net/ipv6/conf/%s/accept_dad", iface);
+	dad_transmits = g_strdup_printf("/proc/sys/net/ipv6/conf/%s/dad_transmits", iface);
+	if (!write_sysctl_zero(accept_dad) || !write_sysctl_zero(dad_transmits))
+		g_warning("Could not disable IPv6 DAD for IMS interface %s", iface);
+
+	cidr = g_strdup_printf("%s/%u", address, prefix);
+	addr_argv[4] = cidr;
+	addr_argv[6] = (gchar *)iface;
+	if (!run_ip(addr_argv)) {
+		g_object_unref(cfg);
+		return;
+	}
+
+	if (gateway && *gateway) {
+		route_argv[6] = (gchar *)gateway;
+		route_argv[8] = (gchar *)iface;
+		run_ip(route_argv);
+	}
+
+	g_info("Configured IMS IPv6 link %s with %s", iface, cidr);
+	g_object_unref(cfg);
+}
+
